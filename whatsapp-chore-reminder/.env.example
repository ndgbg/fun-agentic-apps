# ── Anthropic ────────────────────────────────────────────────────────────────
# Get yours at https://platform.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# 1. Go to https://developers.facebook.com → My Apps → Create App → Business
# 2. Add the "WhatsApp" product to your app
# 3. Under WhatsApp → API Setup you'll find both values below

# The numeric ID of your test/production phone number (NOT the actual phone number)
WHATSAPP_PHONE_NUMBER_ID=1234567890

# Temporary token from the API Setup page, or a permanent System User token
WHATSAPP_ACCESS_TOKEN=EAAxxxxx...

# Any secret string you choose – paste this same value in the Meta webhook form
WHATSAPP_VERIFY_TOKEN=my-secret-webhook-token

# ── Household members ─────────────────────────────────────────────────────────
# E.164 format; only these two numbers can talk to the bot
HOUSEHOLD_USER1_PHONE=+15551234567
HOUSEHOLD_USER1_NAME=Alice

HOUSEHOLD_USER2_PHONE=+15557654321
HOUSEHOLD_USER2_NAME=Bob

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
