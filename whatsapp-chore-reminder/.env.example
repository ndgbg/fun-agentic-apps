# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── WhatsApp Business Cloud API (Meta) ───────────────────────────────────────
# Found in Meta for Developers → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_permanent_or_temporary_access_token_here

# A secret string YOU choose – used once during webhook verification
WHATSAPP_VERIFY_TOKEN=my_super_secret_verify_token_here

# ── Household members ────────────────────────────────────────────────────────
# E.164 format, e.g. +15551234567  (the + is optional here)
HOUSEHOLD_USER1_PHONE=+15551234567
HOUSEHOLD_USER1_NAME=Alice

HOUSEHOLD_USER2_PHONE=+15557654321
HOUSEHOLD_USER2_NAME=Bob

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
